{
  "manifest_version": 3,
  "name": "HH Copilot",
  "version": "0.1.0",
  "description": "Синхронизирует избранные вакансии HH с локальным HH Copilot.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://hh.ru/*",
    "https://*.hh.ru/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hh.ru/*", "https://*.hh.ru/*"],
      "js": ["hh.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HH Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
