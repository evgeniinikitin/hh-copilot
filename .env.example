BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CODEX_BINARY=codex
CODEX_TIMEOUT_SECONDS=120

DATABASE_URL=sqlite:///runtime/hh_copilot.db

MAX_CONCURRENT_AI_JOBS=2
MAX_NEW_VACANCIES_PER_SYNC=30
PROCESSING_STALE_SECONDS=600
MAX_PROCESSING_RETRIES=2

# HH requires a real developer contact in User-Agent. Replace the address below.
HH_USER_AGENT=HH-Copilot/0.1 (you@example.com)
LOG_LEVEL=INFO
